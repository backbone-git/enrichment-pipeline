# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# Never commit .env — it's already in .gitignore.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed for pipeline.py (AC + Google integration), not for the plain
# enrich.py CLI.

# ActiveCampaign — Settings -> Developer in your AC account.
AC_API_URL=https://youraccountname.api-us1.com
AC_API_KEY=your-ac-api-key-here

# Google service account with Docs + Drive API access. Either a path to the
# key file, or the raw JSON key content itself (e.g. for a GitHub Actions
# secret).
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
# Drive folder (shared with the service account) where dossier Docs are created.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here
